                        "facet": {
                            "showOtherSeries": false
                        },
                        "nrqlQueries": [
                            {
                                "accountIds": [
                                    NEW_RELIC_ACCOUNT_ID
                                ],
                                "query": "FROM M365SecureScoreControlScores SELECT latest(description), latest(implementationStatus), latest(score) facet controlCategory, controlName since 1 week ago limit max"
                            }
                        ],
                        "platformOptions": {
                            "ignoreTimeRange": false
                        },
                        "thresholds": [
                            {
                                "columnName": "Status Val",
                                "from": 0,
